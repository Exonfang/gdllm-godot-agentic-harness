# Godot 4+ specific ignores
.godot/
/android/

# Godot generates .uid files for every script on first import; they are recreated on demand and not part of the source. Keeping them out of the diff avoids spurious churn in feature branches.
*.uid

# Worktrees created by the agent harness live here; they are checkouts, never content.
# A worktree committed by accident lands as a stray gitlink (mode 160000) that no .gitmodules explains.
.claude/worktrees/
